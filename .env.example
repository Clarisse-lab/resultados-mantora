# Conexão Postgres (Supabase, Railway ou local)
DATABASE_URL=postgres://mantora:mantora@localhost:5432/mantora
# Segredo para assinar a sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-por-um-segredo-longo
# Protege o endpoint de sincronização agendada (/api/cron/meta)
CRON_SECRET=troque-por-outro-segredo
# Versão da Graph API da Meta
META_API_VERSION=v21.0
